# QuickBid CRM environment variables.
# Copy this file to .env.local and fill in the values. All other .env / .env.* files are git-ignored.
# On Vercel, set the same names under Project Settings > Environment Variables.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle when `next build` runs: set them before
# building and rebuild after any change. Anyone who opens the app can read them, so the three secret
# NEXT_PUBLIC_ values below (waitlist API key, encryption key, Azure connection string) are exposed to
# browser users until those calls move to the backend.

# ---- Backend URLs (public, build time) ----

# Base URL of the QuickBid support API, ending in /api. Used by every support API call
# (src/config/apiUrl.ts). Defaults to this value when unset.
NEXT_PUBLIC_API_URL=https://api.quickbid.co.in/support/api

# Base URL for the waitlist endpoint /qb/users/v1/waitlist. Defaults to this value when unset.
NEXT_PUBLIC_API_BASE_URL=https://api.quickbid.co.in

# Redirect target when the waitlist API returns 401.
NEXT_PUBLIC_WEB_SIGNUP_URL=https://your-website-host.example.com/signup/

# ---- Waitlist (browser, build time) ----

# Value sent in the x-api-key header of the waitlist request. Must match the backend.
NEXT_PUBLIC_WAITLIST_API_KEY=your-waitlist-api-key-here

# Key used to decrypt AES-256-CBC encrypted waitlist responses. Must match the backend.
# A base64 value of 32 bytes is used as-is; any other string is UTF-8 encoded and zero-padded to 32 bytes.
NEXT_PUBLIC_ENCRYPTION_KEY=your-encryption-key-here

# ---- Email marketing (browser, build time) ----

# Azure Communication Services connection string, sent to the backend with each email-marketing send request.
NEXT_PUBLIC_COMMUNICATION_SERVICES_CONNECTION_STRING=endpoint=https://your-resource.communication.azure.com/;accesskey=your-access-key-here

# ---- API_CONFIG in src/config/api.ts (server-only names; not imported by any module yet) ----

# Google OAuth (Analytics scopes)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:3000/your-google-callback-path

# Meta / WhatsApp Business
META_APP_ID=your-meta-app-id-here
META_ACCESS_TOKEN=your-meta-access-token-here
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id-here
WHATSAPP_BUSINESS_ID=your-whatsapp-business-account-id-here

# LinkedIn
LINKEDIN_CLIENT_ID=your-linkedin-client-id-here
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret-here
LINKEDIN_REDIRECT_URI=http://localhost:3000/your-linkedin-callback-path
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token-here
